{
  "name": "gimbi-adventist-hospital",
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    },
    {
      "src": "css/**/*.css",
      "use": "@vercel/static-build"
    },
    {
      "src": "js/**/*.js",
      "use": "@vercel/static-build"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static-build"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static-build"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ghimbi-adventist-general-hospital-1.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://ghimbi-adventist-general-hospital-1.onrender.com/socket.io/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://ghimbi-adventist-general-hospital-1.onrender.com/auth/$1"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/patient-login.html"
    },
    {
      "source": "/staff",
      "destination": "/staff-login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "env": {
    "API_URL": "https://ghimbi-adventist-general-hospital-1.onrender.com/api",
    "WS_URL": "wss://ghimbi-adventist-general-hospital-1.onrender.com"
  }
    }
