# Example environment variables for the backend (DO NOT commit secrets to git)
# Copy this file to .env and fill in values on your server / Render UI.

# App
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://ghimbi-adventist-general-hospital-2.vercel.app

# Database (MongoDB Atlas)
MONGO_URI=

# JWT and auth
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Admin (initial credentials)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# Storage (S3 or equivalent)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment gateway
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=

# Flags
RUN_MIGRATIONS=false
CREATE_INDEXES=false
LOG_LEVEL=info
