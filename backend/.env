# ========== SERVER CONFIGURATION ==========
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gimbi-hospital?retryWrites=true&w=majority
MONGODB_URI_LOCAL=mongodb://localhost:27017/gimbi-hospital

# ========== JWT ==========
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========== EMAIL ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hospital@example.com
SMTP_PASS=your-email-password
SMTP_FROM=Gimbi Hospital <hospital@example.com>

# ========== CLOUDINARY ==========
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========== TWILIO (SMS) ==========
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========== OPENAI ==========
OPENAI_API_KEY=your-openai-api-key

# ========== GOOGLE ==========
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========== SECURITY ==========
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
SESSION_SECRET=your-session-secret

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:3000,https://ghimbi-adventist-general-hospital-2.vercel.app

# ========== FILE UPLOAD ==========
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ========== APP CONFIGURATION ==========
APP_NAME=Gimbi Adventist General Hospital
APP_VERSION=2027.1.0
APP_URL=https://ghimbi-adventist-general-hospital-2.vercel.app
API_URL=https://ghimbi-adventist-general-hospital-1.onrender.com

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ========== BACKUP ==========
BACKUP_PATH=./backups
BACKUP_FREQUENCY=0 0 0 * * * # Daily at midnight

# ========== FEATURE FLAGS ==========
ENABLE_AI=true
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_TELEMEDICINE=true
ENABLE_PWA=true
