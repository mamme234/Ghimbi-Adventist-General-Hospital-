# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://ghimbi-adventist-general-hospital-2.vercel.app

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hospital_management

# JWT
JWT_SECRET=your_jwt_secret_key
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# SMS (Twilio)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_account_sid
SMS_AUTH_TOKEN=your_auth_token
SMS_SENDER=+1234567890

# Cloud Storage (AWS S3)
STORAGE_PROVIDER=aws
STORAGE_BUCKET=hospital-bucket
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key

# Payment (Stripe)
PAYMENT_PROVIDER=stripe
PAYMENT_PUBLIC_KEY=pk_test_...
PAYMENT_SECRET_KEY=sk_test_...
PAYMENT_WEBHOOK_SECRET=whsec_...

# Admin
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=admin123

# Logging
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Features
ENABLE_2FA=true
ENABLE_TELEMEDICINE=true
ENABLE_AI_ASSISTANT=true
ENABLE_QR_PATIENT_CARDS=true
